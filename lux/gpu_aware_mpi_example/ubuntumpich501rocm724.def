Bootstrap: docker
From: rocm/dev-ubuntu-24.04:7.2.4-complete

%environment
    # Point to MPICH binaries, libraries man pages
    export MPICH_DIR=/opt/mpich
    export PATH="$MPICH_DIR/bin:$PATH"
    export LD_LIBRARY_PATH="$MPICH_DIR/lib:$LD_LIBRARY_PATH"
    export MANPATH=$MPICH_DIR/share/man:$MANPATH
    # Point to rocm locations
    export ROCM_PATH=/opt/rocm
    export LD_LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/lib64:$LD_LIBRARY_PATH"
    export PATH="/opt/rocm/bin:$PATH"
    
%files
  ping_pong_gpu_aware.cpp /ping_pong_gpu_aware.cpp

%post
# By default you start at the root '/' location in the container images filesystem
ls

# Installing some prerequisites

apt-get update && apt-get install -y \
  wget less gfortran vim sudo gzip tar make autoconf automake \
 hwloc libhwloc-dev binutils cpp libc6-dev m4 texinfo zlib1g-dev git patch pkg-config which \
 rdma-core libibverbs-dev ibverbs-providers ibverbs-utils librdmacm-dev rdmacm-utils libtool libtool-bin libhwloc-dev hwloc  \
  libnl-genl-3-dev libyaml-dev libmunge-dev


echo "Installing UCX 1.22 and UCC 1.8.0"
wget https://github.com/openucx/ucx/releases/download/v1.22.0/ucx-1.22.0.tar.gz
tar xzf ucx-1.22.0.tar.gz
cd ucx-1.22.0
mkdir build
cd build
../configure --prefix=/usr --with-rdmacm --with-verbs
make -j32 install

cd /
git clone https://github.com/openucx/ucc/
cd ucc
git checkout v1.8.0
./autogen.sh
# --without-cuda --with-rocm-arch=--offload-arch=gfx950 'CPPFLAGS=-I/opt/rocm-7.2.4/include -I/opt/rocm-7.2.4/include/hip -I/opt/rocm-7.2.4/include/hsa' 'LDFLAGS=-L/opt/rocm-7.2.4/lib -L/opt/rocm-7.2.4/lib' --with-rocm=/opt/rocm-7.2.4 --with-ucx=/sw/lux/spack/envs/env_1/opt/gcc-11.5.0/ucx-1.22.0-6mxtgzajy42jdkhytns5642l5uapiwe4 --without-rccl
./configure --prefix=/usr --with-ucx=/usr --without-cuda --with-rocm-arch=--offload-arch=gfx950 'CPPFLAGS=-I/opt/rocm-7.2.4/include -I/opt/rocm-7.2.4/include/hip -I/opt/rocm-7.2.4/include/hsa' 'LDFLAGS=-L/opt/rocm-7.2.4/lib -L/opt/rocm-7.2.4/lib' --with-rocm=/opt/rocm-7.2.4  --without-rccl
make -j32 install

export MPICH_VERSION=5.0.1
export MPICH_URL="http://www.mpich.org/static/downloads/$MPICH_VERSION/mpich-$MPICH_VERSION.tar.gz"
export MPICH_DIR=/opt/mpich

echo "Installing MPICH..."
mkdir -p /mpich
mkdir -p /opt
# Download
cd /mpich && wget -O mpich-$MPICH_VERSION.tar.gz $MPICH_URL && tar --no-same-owner -xzf mpich-$MPICH_VERSION.tar.gz
# Compile and install
# --disable-maintainer-mode --disable-silent-rules --enable-shared --with-pm=no --enable-romio --without-ibverbs --enable-wrapper-rpath=yes --with-yaksa=embedded --without-ze --with-hwloc=/sw/lux/spack/envs/env_1/opt/gcc-11.5.0/hwloc-2.13.0-yhevttzinca6cgun27zk62pvldhudewb --enable-fortran --with-slurm=no --with-pmi=pmi2 --with-pmi2=/usr --with-pmi2-include=/usr/include/slurm --with-pmi2-lib=/usr/lib64/slurmpmi --without-cuda --with-hip=/opt/rocm-7.2.4 --with-device=ch4:ucx --with-ucx=/sw/lux/spack/envs/env_1/opt/gcc-11.5.0/ucx-1.22.0-6mxtgzajy42jdkhytns5642l5uapiwe4 --enable-libxml2 --with-datatype-engine=auto --with-ucc=/sw/lux/spack/envs/env_1/opt/gcc-11.5.0/ucc-1.8.0-7nw424nu2a5jtqvbt4lubgdqwy26vydy --with-rccl=/opt/rocm-7.2.4
#cd /mpich/mpich-$MPICH_VERSION && ./configure  - --with-device=ch4:ucx --with-pmi=pmi2  --prefix=$MPICH_DIR && make -j32 install
cd /mpich/mpich-$MPICH_VERSION && ./configure  --with-ucx=/usr --with-ucc=/usr --with-device=ch4:ucx --with-pmi=pmi2 --with-hip=/opt/rocm-7.2.4  --with-rccl=/opt/rocm-7.2.4 --prefix=$MPICH_DIR && make -j32 install
rm -rf /mpich

# build ping_pong_gpu_aware.cpp
cd /
which hipcc
echo $PATH
export PATH="$MPICH_DIR/bin:/opt/rocm/bin:$PATH"
export ROCM_PATH=/opt/rocm

# ping pong GPU aware MPI
hipcc -o ping_pong_gpu_aware.exe ping_pong_gpu_aware.cpp -I${MPICH_DIR}/include -L${MPICH_DIR}/lib -lmpi
#mpicc -o ping_pong_gpu_aware.exe ping_pong_gpu_aware.o  -L${ROCM_PATH}/lib -lamdhip64

